import SwiftUI

struct SignUpSheet: View {
    
    @ObservedObject var auth: AuthController
    @Binding var isPresented: Bool
    
    @State private var username = ""
    @State private var password = ""
    @State private var confirmPassword = ""
    @State private var showAlert = false
    @State private var alertTitle = "Error"
    @State private var alertMessage = ""
    @State private var created = false
    
    var body: some View {
        VStack(spacing: 16) {
            Text("Create Account")
                .font(.headline)
            
            TextField("Username", text: $username)
                .textFieldStyle(.roundedBorder)
                .autocapitalization(.none)
                .autocorrectionDisabled()
            
            Text("3-20 characters: letters, numbers, . or _")
                .font(.caption)
                .foregroundColor(.gray)
                .frame(maxWidth: .infinity, alignment: .leading)
            
            SecureField("Password (at least 6 characters)", text: $password)
                .textFieldStyle(.roundedBorder)
            
            SecureField("Confirm Password", text: $confirmPassword)
                .textFieldStyle(.roundedBorder)
            
            Button("Sign Up") {
                if username.isEmpty || password.isEmpty {
                    alertTitle = "Error"
                    alertMessage = "Please fill in all fields."
                    showAlert = true
                } else if !auth.isValidUsername(username) {
                    alertTitle = "Error"
                    alertMessage = "Username must be 3-20 characters: letters, numbers, . or _ only."
                    showAlert = true
                } else if password != confirmPassword {
                    alertTitle = "Error"
                    alertMessage = "Passwords do not match."
                    showAlert = true
                } else {
                    auth.signUp(username: username, password: password) { success in
                        if success {
                            created = true
                            alertTitle = "Success"
                            alertMessage = "Account created! You can now log in."
                        } else {
                            created = false
                            alertTitle = "Error"
                            alertMessage = auth.errorMessage ?? "Sign up failed."
                        }
                        showAlert = true
                    }
                }
            }
            .frame(maxWidth: .infinity)
            .padding()
            .background(Color.black)
            .foregroundColor(.white)
            .cornerRadius(10)
            
            Spacer()
        }
        .padding()
        .alert(alertTitle, isPresented: $showAlert) {
            Button("OK") {
                auth.errorMessage = nil
                if created {
                    auth.logout()          // para sa login screen siya dumiretso
                    isPresented = false
                }
            }
        } message: {
            Text(alertMessage)
        }
    }
}
