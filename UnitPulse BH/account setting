import SwiftUI

struct AccountView: View {
    
    @Binding var isLoggedIn: Bool
    @StateObject var auth = AuthController()
    
    @State private var showLogoutConfirm = false
    @State private var showAlert = false
    @State private var alertMessage = ""
    
    var body: some View {
        VStack(alignment: .leading, spacing: 16) {
            
            VStack(alignment: .leading, spacing: 0) {
                Text("Boarding House")
                    .font(.caption)
                    .foregroundColor(.gray)
                Text("UnitPULSE")
                    .font(.system(size: 28, weight: .bold))
            }
            .padding(.horizontal)
            
            VStack(alignment: .leading, spacing: 0) {
                Text("Account")
                    .font(.title2)
                    .fontWeight(.bold)
                Rectangle()
                    .frame(height: 2)
                    .foregroundColor(.black)
            }
            .padding(.horizontal)
            
            // who is logged in
            HStack(spacing: 14) {
                Image(systemName: "person.crop.circle.fill")
                    .font(.system(size: 50))
                
                VStack(alignment: .leading, spacing: 4) {
                    Text("Owner")
                        .fontWeight(.semibold)
                    Text(auth.currentEmail)
                        .font(.caption)
                        .foregroundColor(.gray)
                }
                
                Spacer()
            }
            .padding()
            .background(Color.white)
            .cornerRadius(12)
            .shadow(radius: 2)
            .padding(.horizontal)
            
            Text("ACCOUNT SETTINGS")
                .font(.caption)
                .fontWeight(.semibold)
                .padding(.horizontal)
            
            // sends a reset link to the email of the owner
            Button {
                auth.resetPassword(email: auth.currentEmail) { success in
                    alertMessage = success ? "A password reset link was sent to your email." : (auth.errorMessage ?? "Something went wrong.")
                    showAlert = true
                }
            } label: {
                HStack {
                    Image(systemName: "lock.rotation")
                    Text("Change Password")
                    Spacer()
                    Image(systemName: "chevron.right")
                        .font(.caption)
                        .foregroundColor(.gray)
                }
                .padding()
                .background(Color.white)
                .foregroundColor(.black)
                .cornerRadius(12)
                .shadow(radius: 2)
            }
            .padding(.horizontal)
            
            Spacer()
            
            Button {
                showLogoutConfirm = true
            } label: {
                HStack {
                    Image(systemName: "rectangle.portrait.and.arrow.right")
                    Text("Log Out")
                        .fontWeight(.semibold)
                }
                .frame(maxWidth: .infinity)
                .padding()
                .background(Color.red)
                .foregroundColor(.white)
                .cornerRadius(10)
            }
            .padding(.horizontal)
            .padding(.bottom)
            
        }
        .padding(.top)
        .background(
            LinearGradient(
                colors: [Color(.systemGray3), Color(.systemGray6), Color(.systemGray)],
                startPoint: .top,
                endPoint: .bottom
            )
        )
        .confirmationDialog("Are you sure you want to log out?", isPresented: $showLogoutConfirm, titleVisibility: .visible) {
            Button("Log Out", role: .destructive) {
                if auth.logout() {
                    withAnimation {
                        isLoggedIn = false
                    }
                } else {
                    alertMessage = auth.errorMessage ?? "Could not log out."
                    showAlert = true
                }
            }
            Button("Cancel", role: .cancel) { }
        }
        .alert("Notice", isPresented: $showAlert) {
            Button("OK") {
                auth.errorMessage = nil
            }
        } message: {
            Text(alertMessage)
        }
    }
}


