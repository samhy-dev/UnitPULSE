import Foundation
import Combine
import FirebaseAuth
import FirebaseFirestore

class PaymentController: ObservableObject {
    
    @Published var payments: [Payment] = []
    @Published var errorMessage: String? = nil
    
    private let db = Firestore.firestore()
    private var paymentsListener: ListenerRegistration?
    private var authHandle: AuthStateDidChangeListenerHandle?
    
    init() {
        // every time somebody logs in or out, switch to THAT user's payments
        authHandle = Auth.auth().addStateDidChangeListener { [weak self] _, user in
            self?.startListening(uid: user?.uid)
        }
    }
    
    deinit {
        paymentsListener?.remove()
        if let handle = authHandle {
            Auth.auth().removeStateDidChangeListener(handle)
        }
    }
    
    // users/{uid}/payments
    private var userRef: DocumentReference? {
        guard let uid = Auth.auth().currentUser?.uid else { return nil }
        return db.collection("users").document(uid)
    }
    
    private func startListening(uid: String?) {
        paymentsListener?.remove()
        paymentsListener = nil
        
        // clear the old user's payments first
        payments = []
        
        guard let uid = uid else { return }
        
        paymentsListener = db.collection("users").document(uid).collection("payments")
            .addSnapshotListener { [weak self] snapshot, error in
                if let error = error {
                    print("PAYMENTS LISTENER ERROR:", error)
                    return
                }
                let docs = snapshot?.documents ?? []
                let result: [Payment] = docs.compactMap { doc in
                    do {
                        return try doc.data(as: Payment.self)
                    } catch {
                        print("PAYMENT DECODE ERROR:", error)
                        return nil
                    }
                }
                DispatchQueue.main.async { self?.payments = result }
            }
    }
    
    func recordPayment(tenantName: String, dueDate: String, mode: String, amount: Double, status: String) {
        guard let userRef = userRef else {
            errorMessage = "Please log in first."
            return
        }
        
        let newPayment = Payment(tenantName: tenantName, dueDate: dueDate, modeOfPayment: mode, amount: amount, status: status)
        
        print("RECORD PAYMENT:", tenantName, amount, status)
        do {
            try userRef.collection("payments").addDocument(from: newPayment) { error in
                if let error = error {
                    print("RECORD PAYMENT ERROR:", error)
                    DispatchQueue.main.async { self.errorMessage = error.localizedDescription }
                } else {
                    print("RECORD PAYMENT SAVED")
                }
            }
        } catch {
            print("RECORD PAYMENT ENCODE ERROR:", error)
            errorMessage = error.localizedDescription
        }
    }
}

