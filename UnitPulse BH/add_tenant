import SwiftUI

struct AddTenantSheet: View {
    
    @ObservedObject var controller: TenantController
    @Binding var isPresented: Bool
    var editingTenant: Tenant?   // nil = Add, has value = Edit
    
    @State private var name = ""
    @State private var email = ""
    @State private var room = ""
    @State private var rate = ""
    @State private var rateType = "Monthly"
    
    let rateTypeOptions = ["Daily", "Monthly"]
    
    // Save stays dim until everything is filled
    var isFormEmpty: Bool {
        name.isEmpty || email.isEmpty || room.isEmpty || rate.isEmpty
    }
    
    var body: some View {
        VStack(spacing: 16) {
            
            Text(editingTenant == nil ? "Add Tenant" : "Edit Tenant")
                .font(.system(size: 14))
                .foregroundColor(Color(white: 0.2))
            
            // full name
            TextField("Enter Full Name", text: $name)
                .font(.system(size: 14))
                .foregroundColor(.black)
                .padding(.horizontal, 18)
                .padding(.vertical, 13)
                .background(Color(white: 0.96))
                .clipShape(Capsule())
                .shadow(color: .black.opacity(0.18), radius: 3, y: 2)
            
            // email
            TextField("Email Address", text: $email)
                .font(.system(size: 14))
                .foregroundColor(.black)
                .keyboardType(.emailAddress)
                .autocapitalization(.none)
                .padding(.horizontal, 18)
                .padding(.vertical, 13)
                .background(Color(white: 0.96))
                .clipShape(Capsule())
                .shadow(color: .black.opacity(0.18), radius: 3, y: 2)
            
            // room dropdown, small pill in the middle
            Menu {
                ForEach(controller.rooms) { r in
                    Button(r.name) {
                        room = r.name
                    }
                }
            } label: {
                HStack(spacing: 6) {
                    Text(room.isEmpty ? "Room" : room)
                    Image(systemName: "chevron.up.chevron.down")
                        .font(.system(size: 12, weight: .semibold))
                }
                .font(.system(size: 15, weight: .medium))
                .foregroundColor(Color(white: 0.35))
                .padding(.horizontal, 22)
                .padding(.vertical, 10)
                .background(Color(white: 0.96))
                .clipShape(Capsule())
                .shadow(color: .black.opacity(0.18), radius: 3, y: 2)
            }
            .frame(maxWidth: .infinity)
            
            if controller.rooms.isEmpty {
                Text("No rooms yet. Add one in Manage Rooms.")
                    .font(.system(size: 11))
                    .foregroundColor(.gray)
            }
            
            // rate type dropdown
            VStack(alignment: .leading, spacing: 6) {
                Text("Rate Type")
                    .font(.system(size: 12))
                    .foregroundColor(.gray)
                    .padding(.leading, 6)
                
                Menu {
                    ForEach(rateTypeOptions, id: \.self) { option in
                        Button(option) {
                            rateType = option
                        }
                    }
                } label: {
                    HStack(spacing: 6) {
                        Text(rateType)
                        Image(systemName: "chevron.up.chevron.down")
                            .font(.system(size: 12, weight: .semibold))
                        Spacer()
                    }
                    .font(.system(size: 14))
                    .foregroundColor(Color(white: 0.4))
                    .padding(.horizontal, 18)
                    .padding(.vertical, 13)
                    .background(Color(white: 0.96))
                    .clipShape(Capsule())
                    .shadow(color: .black.opacity(0.18), radius: 3, y: 2)
                }
            }
            
            // rate
            TextField("\(rateType) Rate", text: $rate)
                .font(.system(size: 14))
                .foregroundColor(.black)
                .keyboardType(.decimalPad)
                .padding(.horizontal, 18)
                .padding(.vertical, 13)
                .background(Color(white: 0.96))
                .clipShape(Capsule())
                .shadow(color: .black.opacity(0.18), radius: 3, y: 2)
            
            // save button
            Button {
                let rateValue = Double(rate) ?? 0
                
                if let tenant = editingTenant {
                    controller.updateTenant(tenant, name: name, email: email, room: room, rate: rateValue, rateType: rateType)
                } else {
                    controller.addTenant(name: name, email: email, room: room, rate: rateValue, rateType: rateType)
                }
                
                isPresented = false
            } label: {
                Text("Save")
                    .font(.system(size: 15, weight: .semibold))
                    .foregroundColor(.white)
                    .frame(maxWidth: .infinity)
                    .frame(height: 48)
                    .background(Color(white: 0.13))
                    .clipShape(Capsule())
            }
            .padding(.horizontal, 36)
            .padding(.top, 6)
            .disabled(isFormEmpty)
            .opacity(isFormEmpty ? 0.5 : 1)
            
        }
        .padding(22)
        .background(Color(white: 0.9))
        .cornerRadius(28)
        .shadow(color: .black.opacity(0.3), radius: 10, y: 8)
        .padding(.horizontal, 24)
        .onAppear {
            if let tenant = editingTenant {
                // Edit mode: fill the card with the tenant's info
                name = tenant.name
                email = tenant.email
                room = tenant.room
                rate = "\(Int(tenant.rate))"
                rateType = tenant.rateType
            }
        }
    }
}

