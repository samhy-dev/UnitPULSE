import Foundation
import Combine

class AuthController: ObservableObject {
    
    @Published var errorMessage: String? = nil
    
    // create account: saves the username and password in the phone
    func signUp(username: String, password: String) -> Bool {
        if username.isEmpty || password.isEmpty {
            errorMessage = "Please fill in all fields."
            return false
        }
        
        UserDefaults.standard.set(username, forKey: "savedUsername")
        UserDefaults.standard.set(password, forKey: "savedPassword")
        return true
    }
    
    // log in: checks what the user typed against the saved account
    func login(username: String, password: String) -> Bool {
        if username.isEmpty || password.isEmpty {
            errorMessage = "Please enter your username and password."
            return false
        }
        
        let savedUsername = UserDefaults.standard.string(forKey: "savedUsername")
        let savedPassword = UserDefaults.standard.string(forKey: "savedPassword")
        
        if savedUsername == nil {
            errorMessage = "No account yet. Please sign up first."
            return false
        }
        
        if username == savedUsername && password == savedPassword {
            return true
        }
        
        errorMessage = "Incorrect username or password."
        return false
    }
}




