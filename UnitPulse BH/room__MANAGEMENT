import SwiftUI

struct RoomManagementSheet: View {
    
    @ObservedObject var controller: TenantController
    @Binding var isPresented: Bool
    
    @State private var newRoomName = ""
    @State private var showError = false
    
    var isNameEmpty: Bool {
        newRoomName.trimmingCharacters(in: .whitespaces).isEmpty
    }
    
    var body: some View {
        VStack(spacing: 14) {
            
            Text("Manage Rooms")
                .font(.system(size: 14))
                .foregroundColor(Color(white: 0.2))
            
            // new room name
            TextField("New Room Name", text: $newRoomName)
                .font(.system(size: 14))
                .foregroundColor(.black)
                .padding(.horizontal, 18)
                .padding(.vertical, 13)
                .background(Color(white: 0.96))
                .clipShape(Capsule())
                .shadow(color: .black.opacity(0.18), radius: 3, y: 2)
            
            // add button
            Button {
                controller.addRoom(name: newRoomName)
                
                if controller.errorMessage == nil {
                    newRoomName = ""
                } else {
                    showError = true
                }
            } label: {
                Text("Add")
                    .font(.system(size: 15, weight: .semibold))
                    .foregroundColor(.white)
                    .padding(.horizontal, 40)
                    .frame(height: 44)
                    .background(Color(white: 0.13))
                    .clipShape(Capsule())
            }
            .disabled(isNameEmpty)
            .opacity(isNameEmpty ? 0.5 : 1)
            
            // room list
            if controller.rooms.isEmpty {
                Text("No rooms added yet")
                    .font(.system(size: 12))
                    .foregroundColor(.gray)
                    .padding(.vertical, 12)
            } else {
                ScrollView {
                    VStack(spacing: 8) {
                        ForEach(controller.rooms) { room in
                            HStack {
                                Text(room.name)
                                    .font(.system(size: 14))
                                    .foregroundColor(Color(white: 0.3))
                                Spacer()
                                Button {
                                    controller.deleteRoom(room)
                                    if controller.errorMessage != nil {
                                        showError = true
                                    }
                                } label: {
                                    Image(systemName: "trash")
                                        .font(.system(size: 14))
                                        .foregroundColor(.red)
                                }
                            }
                            .padding(.horizontal, 18)
                            .padding(.vertical, 11)
                            .background(Color(white: 0.96))
                            .clipShape(Capsule())
                            .shadow(color: .black.opacity(0.12), radius: 2, y: 1)
                        }
                    }
                    .padding(.vertical, 4)
                    .padding(.horizontal, 2)
                }
                .frame(maxHeight: 180)
            }
            
            // done button
            Button {
                isPresented = false
            } label: {
                Text("Done")
                    .font(.system(size: 15, weight: .semibold))
                    .foregroundColor(.white)
                    .frame(maxWidth: .infinity)
                    .frame(height: 48)
                    .background(Color(white: 0.13))
                    .clipShape(Capsule())
            }
            .padding(.horizontal, 36)
            .padding(.top, 6)
        }
        .padding(22)
        .background(Color(white: 0.9))
        .cornerRadius(28)
        .shadow(color: .black.opacity(0.3), radius: 10, y: 8)
        .padding(.horizontal, 24)
        .environment(\.colorScheme, .light)
        .alert("Error", isPresented: $showError) {
            Button("OK") {
                controller.errorMessage = nil
            }
        } message: {
            Text(controller.errorMessage ?? "")
        }
    }
}
